{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@core": [
        "./src/app/core"
      ],
      "@core/*": [
        "./src/app/core/*"
      ],
      "@env/*": [
        "./src/environments/*"
      ],
      "@env": [
        "./src/environments/environment"
      ],
      "@mocks/*": [
        "./src/app/core/mocks/*"
      ],
      "@mocks": [
        "./src/app/core/mocks"
      ],
      "@src/*": [
        "./src/*"
      ]
    },
    "types": [
      "vitest/globals",
      "google.accounts"
    ],
    "target": "es2022"
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "src/test-setup.ts"
  ],
  "files": [
    "src/test-setup.ts"
  ]
}
